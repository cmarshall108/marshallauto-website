[Unit]
Description=Send due Marshall Auto inventory alerts
After=network-online.target marshallauto.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/marshallauto-website
Environment=FLASK_ENV=production
ExecStart=/usr/bin/bash /opt/marshallauto-website/deploy/process_alerts.sh
TimeoutStartSec=5min
