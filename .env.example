SECRET_KEY=change-me-to-a-random-32-char-string
# Required for online financing applications. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FINANCING_ENCRYPTION_KEY=
# Encrypted daily data backups → separate private GitHub repo (ciphertext only).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Store this key in a password manager; it is never written into the backup repo.
BACKUP_ENCRYPTION_KEY=
# BACKUP_ENABLED=true
# Private empty repo created for backups only (not this application repo).
# BACKUP_GIT_URL=https://github.com/your-org/marshallauto-data-backups.git
# BACKUP_GIT_URL=git@github.com:your-org/marshallauto-data-backups.git
# BACKUP_GIT_BRANCH=main
# HTTPS auth (fine-grained PAT with contents:write on the backup repo only):
# BACKUP_GITHUB_TOKEN=
# BACKUP_RETENTION_COUNT=30
# BACKUP_INCLUDE_PUBLIC_UPLOADS=true
# BACKUP_INCLUDE_COMING_SOON_STOCK=true
# Optional extra on-box copies of .mbak files:
# BACKUP_LOCAL_DIR=/var/backups/marshallauto/encrypted

# Textbelt API key for financing alerts when no administrator is online.
TEXTBELT_API_KEY=
# Keep SECRET_KEY stable and private: it also encrypts admin authenticator secrets.
# Changing it invalidates sessions and requires a server-owner 2FA reset/re-enrollment.
PORT=8080
DATABASE_URL=sqlite:///marshall_auto.db
# Optional production services. Leave blank to keep local SQLite behavior.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/marshallauto
# REDIS_URL=redis://localhost:6379/0
# PUBLIC_CACHE_ENABLED=true
# PUBLIC_CACHE_SECONDS=60
# ALERT_WORKER_INTERVAL_SECONDS=300
# START_HIGHLIGHT_WORKER=1
# START_ALERT_WORKER=1
# IMAGE_CDN_BASE_URL=
# SENTRY_DSN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# Max total upload size per request in bytes (default 256MB). Raise if bulk vehicle photos fail.
# MAX_CONTENT_LENGTH=268435456
SITE_URL=https://marshallautosanford.com
BUSINESS_NAME=Marshall Auto LLC
BUSINESS_PHONE=(919)-215-0702
BUSINESS_EMAIL=sales@marshallautosanford.com
BUSINESS_ADDRESS=360 Wilson Rd
BUSINESS_CITY=Sanford
BUSINESS_STATE=NC
BUSINESS_ZIP=27332
BUSINESS_LATITUDE=35.4438494
BUSINESS_LONGITUDE=-79.1374067
# Analytics (also editable in Admin → Settings; DB overrides env when set)
GOOGLE_TAG_ID=
GOOGLE_ANALYTICS_ID=
FACEBOOK_PIXEL_ID=
FACEBOOK_APP_ID=
# Facebook Page publishing (Graph API). Does NOT create Marketplace listings —
# Meta has no public API for ordinary apps to auto-list on Marketplace.
# Create a Meta app, connect your Page, generate a long-lived Page access token
# with pages_manage_posts, pages_read_engagement, pages_show_list.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Optional env fallbacks — preferred place to enter these is Admin → Settings
# Master env fallback for enabling posts (Admin → Settings can also toggle)
FACEBOOK_AUTO_POST_VEHICLES=false
TWITTER_HANDLE=
INSTAGRAM_URL=
FACEBOOK_URL=
YOUTUBE_URL=
# Photo highlights — Grok vision (xAI). Worker uses this; never commit real keys.
# Get a key at https://console.x.ai/
XAI_API_KEY=
VIN_GROK_MODEL=grok-4.20-0309-non-reasoning
PHOTO_HIGHLIGHTS_ENGINE=grok
PHOTO_HIGHLIGHTS_GROK_MODEL=grok-4.7
PHOTO_HIGHLIGHTS_MAX=5
# PHOTO_HIGHLIGHTS_ENGINE=opencv   # local OpenCV only (crude; mislabels interiors — not recommended)
# PHOTO_HIGHLIGHTS_OPENCV_FALLBACK=true  # publish OpenCV guesses when Grok fails (default: retry instead)

# IndexNow (Bing/Yandex partners). Generate with:
# python -c "import secrets; print(secrets.token_hex(16))"
# INDEXNOW_KEY=
# INDEXNOW_ENABLED=true
# INDEXNOW_TIMEOUT=3
